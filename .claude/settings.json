{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(sudo *)"
    ],
    "allow": [
      "Bash(git [add|commit|diff|status] *)"
    ]
  },
  "hooks": {}
}
